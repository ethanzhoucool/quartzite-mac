+# macOS: Apple ld has no "-r -b binary"; embed blobs with an assembler .incbin
+# stub that defines the same _binary_<name>_start/_end symbols.
+function(mistral_embed_bin OBJ BIN SYM)
+    if(APPLE)
+        set(ASM ${CMAKE_CURRENT_BINARY_DIR}/${OBJ}.S)
+        file(WRITE ${ASM} "\t.section __TEXT,__const\n\t.globl __binary_${SYM}_start\n\t.globl __binary_${SYM}_end\n\t.p2align 4\n__binary_${SYM}_start:\n\t.incbin \"${CMAKE_CURRENT_BINARY_DIR}/${BIN}\"\n__binary_${SYM}_end:\n\t.byte 0\n")
+        add_custom_command(
+           OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${OBJ}
+           WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
+           COMMAND ${CMAKE_CXX_COMPILER} -c -x assembler ${ASM} -o ${OBJ}
+           DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${BIN}
+        )
+    else()
+        add_custom_command(
+           OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${OBJ}
+           WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
+           COMMAND ld -r -b binary -o ${OBJ} ${BIN}
+           DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${BIN}
+        )
+    endif()
+endfunction()
+
